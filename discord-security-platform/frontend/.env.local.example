# Public — safe to expose in the browser bundle. No secrets live here;
# the real secrets (bot token, client secret, JWT signing key) stay on
# the backend, per the architecture in ../docs/ARCHITECTURE.md.

# Backend's single origin — REST lives at this URL directly,
# the WebSocket client appends /public-ws itself.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
NEXT_PUBLIC_DISCORD_CLIENT_ID=your_client_id

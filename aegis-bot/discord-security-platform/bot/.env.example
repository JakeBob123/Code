DISCORD_BOT_TOKEN=your_bot_token           # NEVER commit, never expose to frontend
DISCORD_CLIENT_ID=your_client_id

# Where the /dashboard button links to
DASHBOARD_URL=https://yourdashboard.com

# Origin of the backend's single HTTP server — the client appends
# /internal-ws itself (see src/ws/backendClient.js). Use wss:// in
# production (e.g. Render), ws:// for local dev.
BACKEND_INTERNAL_WS_URL=ws://localhost:8080
INTERNAL_WS_SHARED_SECRET=change_me_shared_with_backend

# Render (and most PaaS hosts) sets PORT automatically for the bot's
# health-check server (see src/healthServer.js) — leave unset in
# production, only needed for local dev if 3000 is already taken.
PORT=3000
